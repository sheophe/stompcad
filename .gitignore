# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test & coverage artefacts
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Type checker / linter caches
.mypy_cache/
.ruff_cache/
.dmypy.json

# Mutation testing. `mutmut run` copies the whole tree into mutants/ and
# rewrites the sources there; nothing in it is authored.
mutants/
mutants.sqlite

# Editor / OS cruft
.DS_Store
*.swp
.idea/
.vscode/

# SDD scratch
.superpowers/

# Session docs that might go stale
docs/superpowers/

# Agent worktrees (native harness-managed)
.claude/worktrees/

# Proprietary docs that can be found outside this repository
docs/parts/*.pdf
